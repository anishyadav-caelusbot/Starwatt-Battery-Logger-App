# InfluxDB Connection Details
# If running InfluxDB on your host machine, use http://host.docker.internal:8086
INFLUX_URL=http://host.docker.internal:8086
INFLUX_TOKEN=your_influxdb_admin_or_read_write_token_here
INFLUX_ORG=starwatt
INFLUX_BUCKET=philips

# Mock Telemetry Mode
# Set to 'true' to run with a simulated high-fidelity LFP/NMC battery telemetry engine.
# Set to 'false' to pull real live data from your InfluxDB database using flux queries.
MOCK_MODE=true

# Admin Dashboard Access Credentials (Public facing setup)
ADMIN_USER=starwatt
ADMIN_PASS=Superman$12
